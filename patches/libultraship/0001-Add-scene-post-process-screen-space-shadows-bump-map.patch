+/*
+ * Scene post-processing (screen-space shadows, bump mapping, specular).
+ * Place at the end of the world's opaque display list, before any HUD drawing. The renderer reconstructs
+ * world-space positions from the depth buffer, so the sun direction must be in the same space as the
+ * model matrices (world space for OoT). The pointed-to struct must remain valid until the frame is rendered.
+ */
+typedef struct ScenePostFxParams {
+    float sunDir[3];       /* world-space direction pointing toward the light, need not be normalized */
+    float shadowStrength;  /* 0 disables shadows, 1 is fully black */
+    float shadowDistance;  /* how far (world units) to search for occluders along the light direction */
+    float shadowThickness; /* occluders thicker than this (view-depth units) are ignored */
+    float bumpStrength;    /* 0 disables bump mapping */
+    float specStrength;    /* 0 disables specular */
+    float specPower;       /* specular exponent */
+    int32_t shadowSteps;   /* ray-march samples per pixel (cost scales linearly) */
+} ScenePostFxParams;
+
+#define gSPScenePostFx(pkt, params)                   \
+    {                                                 \
+        Gfx* _g = (Gfx*)(pkt);                        \
+                                                      \
+        _g->words.w0 = _SHIFTL(G_SCENEPOSTFX, 24, 8); \
+        _g->words.w1 = (uintptr_t)(params);           \
+    }
+
+#define gsSPScenePostFx(params) \
+    { (_SHIFTL(G_SCENEPOSTFX, 24, 8)), (uintptr_t)(params) }
+
 #define gsSPPushShader(shader)                                  \
